{
  "apiVersion": "v1.2",
  "name": "metals-collector-pilot",
  "description": "Pilot stack: PostgreSQL 16 and the metals L1 collector, both in containers. Push to main runs this template.",
  "arguments": {
    "PROJECT_ID": "",
    "DB_PASSWORD": "collector"
  },
  "options": {
    "autorun": true,
    "runOnUpdate": true,
    "concurrencyPolicy": "queue"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "DeploymentService",
          "ref": "postgres",
          "spec": {
            "name": "postgres",
            "projectId": "${args.PROJECT_ID}",
            "billing": {
              "deploymentPlan": "nf-compute-50"
            },
            "deployment": {
              "type": "statefulSet",
              "instances": 1,
              "external": {
                "imagePath": "postgres:16-alpine"
              },
              "docker": {
                "configType": "default"
              },
              "gracePeriodSeconds": 30,
              "volumes": [
                {
                  "id": "pgdata",
                  "mounts": [
                    {
                      "containerMountPath": "/var/lib/postgresql/data"
                    }
                  ],
                  "spec": {
                    "accessMode": "ReadWriteOnce",
                    "storageClassName": "nvme",
                    "storageSize": 6144
                  }
                }
              ]
            },
            "runtimeEnvironment": {
              "POSTGRES_USER": "collector",
              "POSTGRES_PASSWORD": "${args.DB_PASSWORD}",
              "POSTGRES_DB": "collector"
            },
            "ports": [
              {
                "name": "pg",
                "internalPort": 5432,
                "protocol": "TCP",
                "public": false,
                "vpcAccessible": false
              }
            ],
            "healthChecks": [
              {
                "protocol": "CMD",
                "type": "livenessProbe",
                "cmd": "pg_isready -U collector -d collector",
                "initialDelaySeconds": 10,
                "periodSeconds": 10,
                "timeoutSeconds": 3,
                "failureThreshold": 5,
                "successThreshold": 1
              }
            ]
          }
        },
        {
          "kind": "Condition",
          "spec": {
            "kind": "Service",
            "spec": {
              "data": {
                "serviceId": "${refs.postgres.id}"
              },
              "type": "running"
            }
          }
        },
        {
          "kind": "CombinedService",
          "ref": "collector",
          "spec": {
            "name": "collector",
            "projectId": "${args.PROJECT_ID}",
            "billing": {
              "deploymentPlan": "nf-compute-10",
              "buildPlan": "nf-compute-400-16"
            },
            "deployment": {
              "instances": 1,
              "storage": {
                "ephemeralStorage": {
                  "storageSize": 1024
                },
                "shmSize": 64
              },
              "docker": {
                "configType": "default"
              },
              "gracePeriodSeconds": 30
            },
            "runtimeEnvironment": {
              "DB_DSN": "postgres://collector:${args.DB_PASSWORD}@postgres:5432/collector?sslmode=disable",
              "SYMBOLS": "XPTUSDT,XPDUSDT,XAUUSDT,XAGUSDT",
              "LOG_LEVEL": "info"
            },
            "vcsData": {
              "projectType": "github",
              "projectUrl": "https://github.com/svirmi/weather-api.git",
              "projectBranch": "main"
            },
            "ports": [
              {
                "internalPort": 9090,
                "protocol": "HTTP",
                "name": "p01",
                "public": true,
                "domains": [],
                "security": {
                  "policies": [],
                  "credentials": []
                },
                "disableNfDomain": false
              }
            ],
            "buildSettings": {
              "dockerfile": {
                "buildEngine": "buildkit",
                "dockerWorkDir": "/",
                "dockerFilePath": "/Dockerfile",
                "buildkit": {
                  "useCache": false,
                  "cacheStorageSize": 16384
                }
              }
            },
            "disabledCI": false,
            "buildConfiguration": {
              "pathIgnoreRules": [],
              "isAllowList": false,
              "ciIgnoreFlagsEnabled": false
            },
            "healthChecks": [
              {
                "protocol": "HTTP",
                "type": "livenessProbe",
                "path": "/healthz",
                "port": 9090,
                "initialDelaySeconds": 15,
                "periodSeconds": 30,
                "timeoutSeconds": 3,
                "failureThreshold": 3,
                "successThreshold": 1
              }
            ]
          }
        }
      ]
    }
  }
}
