{
  "$schema": "https://api.northflank.com/v1/schemas/template",
  "apiVersion": "v1.2",
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "ref": "project",
          "kind": "Project",
          "spec": {
            "name": "weather api",
            "color": "#57637A",
            "networking": {
              "allowedIngressProjects": [],
              "hostAliases": {
                "enabled": false
              }
            },
            "region": "europe-west"
          },
          "updateMode": "put"
        },
        {
          "kind": "Workflow",
          "spec": {
            "context": {
              "projectId": "${refs.project.id}"
            },
            "type": "sequential",
            "steps": [
              {
                "ref": "pg",
                "kind": "Addon",
                "spec": {
                  "name": "pg-1",
                  "infrastructure": {
                    "architecture": "x86"
                  },
                  "type": "postgresql",
                  "version": "16",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "storageClass": "nvme",
                    "storage": 6144,
                    "replicas": 1
                  },
                  "tlsEnabled": true
                },
                "updateMode": "put"
              },
              {
                "kind": "SecretGroup",
                "spec": {
                  "name": "API-KEYS",
                  "type": "secret",
                  "secretType": "environment-arguments",
                  "priority": 10,
                  "secrets": {
                    "variables": {},
                    "files": {}
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.pg.id}",
                      "keys": [
                        {
                          "keyName": "POSTGRES_URI",
                          "aliases": [
                            "DB_DSN"
                          ]
                        }
                      ]
                    }
                  ],
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": [],
                    "stageIds": []
                  }
                },
                "updateMode": "put"
              },
              {
                "kind": "Condition",
                "spec": {
                  "kind": "Addon",
                  "spec": {
                    "data": {
                      "addonId": "${refs.pg.id}"
                    },
                    "type": "running"
                  }
                }
              },
              {
                "kind": "CombinedService",
                "spec": {
                  "name": "weather-api",
                  "infrastructure": {
                    "architecture": "x86"
                  },
                  "billing": {
                    "buildPlan": "nf-compute-400-16",
                    "deploymentPlan": "nf-compute-10"
                  },
                  "deployment": {
                    "type": "deployment",
                    "instances": 1,
                    "gracePeriodSeconds": 30,
                    "docker": {
                      "configType": "default"
                    }
                  },
                  "ports": [
                    {
                      "name": "p01",
                      "internalPort": 9090,
                      "protocol": "HTTP",
                      "public": true,
                      "security": {
                        "credentials": [],
                        "policies": [],
                        "sso": {}
                      }
                    }
                  ],
                  "loadBalancing": {
                    "mode": "leastConnection"
                  },
                  "buildSource": "git",
                  "disabledCI": true,
                  "vcsData": {
                    "projectUrl": "https://github.com/svirmi/weather-api",
                    "projectType": "github",
                    "projectBranch": "main",
                    "accountLogin": "svirmi"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "buildkit",
                      "dockerFilePath": "/Dockerfile",
                      "dockerWorkDir": "/",
                      "buildkit": {
                        "useCache": false,
                        "cacheStorageSize": 16384
                      },
                      "scan": {
                        "enabled": false
                      }
                    },
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 16384
                      }
                    }
                  },
                  "runtimeEnvironment": {
                    "SYMBOLS": "XPTUSDT,XPDUSDT,XAUUSDT,XAGUSDT",
                    "LOG_LEVEL": "info"
                  },
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "livenessProbe",
                      "path": "/healthz",
                      "port": 9090,
                      "initialDelaySeconds": 15,
                      "periodSeconds": 30,
                      "timeoutSeconds": 3,
                      "failureThreshold": 3
                    }
                  ],
                  "buildConfiguration": {
                    "pathIgnoreRules": [],
                    "isAllowList": false,
                    "ciIgnoreFlagsEnabled": true
                  },
                  "buildArguments": {}
                },
                "updateMode": "put"
              },
              {
                "kind": "CombinedService",
                "spec": {
                  "name": "rawproxy",
                  "infrastructure": {
                    "architecture": "x86"
                  },
                  "billing": {
                    "buildPlan": "nf-compute-400-16",
                    "deploymentPlan": "nf-compute-10"
                  },
                  "deployment": {
                    "type": "deployment",
                    "instances": 1,
                    "gracePeriodSeconds": 30,
                    "docker": {
                      "configType": "default"
                    }
                  },
                  "ports": [
                    {
                      "name": "p01",
                      "internalPort": 9092,
                      "protocol": "HTTP",
                      "public": true,
                      "security": {
                        "credentials": [],
                        "policies": [],
                        "sso": {}
                      }
                    }
                  ],
                  "loadBalancing": {
                    "mode": "leastConnection"
                  },
                  "buildSource": "git",
                  "disabledCI": true,
                  "vcsData": {
                    "projectUrl": "https://github.com/svirmi/weather-api",
                    "projectType": "github",
                    "projectBranch": "main",
                    "accountLogin": "svirmi"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "buildkit",
                      "dockerFilePath": "/Dockerfile.rawproxy",
                      "dockerWorkDir": "/",
                      "buildkit": {
                        "useCache": false,
                        "cacheStorageSize": 16384
                      },
                      "scan": {
                        "enabled": false
                      }
                    },
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 16384
                      }
                    }
                  },
                  "runtimeEnvironment": {
                    "RAWPROXY_ADDR": ":9092",
                    "LOG_LEVEL": "info"
                  },
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "livenessProbe",
                      "path": "/healthz",
                      "port": 9092,
                      "initialDelaySeconds": 15,
                      "periodSeconds": 30,
                      "timeoutSeconds": 3,
                      "failureThreshold": 3
                    }
                  ],
                  "buildConfiguration": {
                    "pathIgnoreRules": [],
                    "isAllowList": false,
                    "ciIgnoreFlagsEnabled": true
                  },
                  "buildArguments": {}
                },
                "updateMode": "put"
              }
            ]
          }
        }
      ]
    }
  },
  "options": {
    "autorun": false,
    "concurrencyPolicy": "queue"
  },
  "gitops": {
    "repoUrl": "https://github.com/svirmi/weather-api",
    "vcsService": "github",
    "accountLogin": "svirmi",
    "branch": "main",
    "filePath": "/northflank.json"
  }
}