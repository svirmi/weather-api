{
  "apiVersion": "v1.2",
  "name": "metals-collector-pilot",
  "description": "Deploys the metals L1 collector container on pushes to main. PostgreSQL is the Northflank managed addon, supplied via the DB_DSN argument override.",
  "arguments": {
    "PROJECT_ID": "",
    "DB_DSN": ""
  },
  "options": {
    "autorun": true,
    "runOnUpdate": true,
    "concurrencyPolicy": "queue"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "CombinedService",
          "ref": "collector",
          "spec": {
            "name": "collector",
            "projectId": "${args.PROJECT_ID}",
            "billing": {
              "deploymentPlan": "nf-compute-10",
              "buildPlan": "nf-compute-400-16"
            },
            "deployment": {
              "instances": 1,
              "storage": {
                "ephemeralStorage": {
                  "storageSize": 1024
                },
                "shmSize": 64
              },
              "docker": {
                "configType": "default"
              },
              "gracePeriodSeconds": 30
            },
            "runtimeEnvironment": {
              "DB_DSN": "${args.DB_DSN}",
              "SYMBOLS": "XPTUSDT,XPDUSDT,XAUUSDT,XAGUSDT",
              "LOG_LEVEL": "info"
            },
            "vcsData": {
              "projectType": "github",
              "projectUrl": "https://github.com/svirmi/weather-api.git",
              "projectBranch": "main"
            },
            "ports": [
              {
                "internalPort": 9090,
                "protocol": "HTTP",
                "name": "p01",
                "public": true,
                "domains": [],
                "security": {
                  "policies": [],
                  "credentials": []
                },
                "disableNfDomain": false
              }
            ],
            "buildSettings": {
              "dockerfile": {
                "buildEngine": "buildkit",
                "dockerWorkDir": "/",
                "dockerFilePath": "/Dockerfile",
                "buildkit": {
                  "useCache": false,
                  "cacheStorageSize": 16384
                }
              }
            },
            "disabledCI": false,
            "buildConfiguration": {
              "pathIgnoreRules": [],
              "isAllowList": false,
              "ciIgnoreFlagsEnabled": false
            },
            "healthChecks": [
              {
                "protocol": "HTTP",
                "type": "livenessProbe",
                "path": "/healthz",
                "port": 9090,
                "initialDelaySeconds": 15,
                "periodSeconds": 30,
                "timeoutSeconds": 3,
                "failureThreshold": 3,
                "successThreshold": 1
              }
            ]
          }
        }
      ]
    }
  }
}
